{
  "name": "margin-reader-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "api:generate": "node ../scripts/api.mjs generate",
    "api:check": "node ../scripts/api.mjs check",
    "api:watch": "node ../scripts/api.mjs watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src --ignore-path /dev/null",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "orval": "^8.47.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
