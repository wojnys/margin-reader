# Copy to .env. Never put this key in the React frontend.
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# Current promotional standard-tier USD rates; update if provider pricing changes.
DEEPINFRA_INPUT_PRICE=0.098
DEEPINFRA_OUTPUT_PRICE=0.294
# Chat Completions accepts named levels; low keeps the reasoning budget modest.
DEEPINFRA_REASONING_EFFORT=low
DEEPINFRA_TEMPERATURE=1.0
DEEPINFRA_TOP_P=0.95
# Substitute USER/PASSWORD; see README for compose.yaml's public local-development defaults.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5437/margin
DATA_DIR=./data
KNOWLEDGE_ENABLED=true
KNOWLEDGE_REASONING_EFFORT=none
KNOWLEDGE_TASK_QUEUE=margin-knowledge
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_LOCAL_NEO4J_PASSWORD
KNOWLEDGE_EVIDENCE_TOKENS=6000
TEMPORAL_ADDRESS=127.0.0.1:7323
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=margin-reading
# Set this if automatic LAN address detection is incorrect, e.g. http://192.168.1.20:5187
PHONE_BASE_URL=
